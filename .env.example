# GhostTrace Environment Configuration Template
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# NOTE: GhostTrace is a 100% offline, privacy-first tool.
# Core detection and sanitization logic runs entirely on local CPU with ZERO telemetry.
#
# Server Configuration (Optional overrides)
GHOSTTRACE_HOST=127.0.0.1
GHOSTTRACE_PORT=7860

# Maximum file upload size in bytes (Default: 26214400 = 25MB)
GHOSTTRACE_MAX_PAYLOAD_BYTES=26214400

# Optional: Default LLM / CLI binary used by 'ghosttrace cleanse'
# Options: ollama, claude, gpt, or custom local CLI
GHOSTTRACE_CLEANSE_CMD=ollama run llama3
